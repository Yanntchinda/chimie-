<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:orientation="vertical"
    android:background="@drawable/lock_item_bg"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    android:elevation="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/lockDot"
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:layout_marginEnd="7dp"
            android:src="@drawable/dot_grey"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/lockSource"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#C7FFFFFF"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="" />

        <TextView
            android:id="@+id/lockTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textSize="11sp"
            android:textColor="#8FFFFFFF"
            android:text="" />
    </LinearLayout>

    <TextView
        android:id="@+id/lockSender"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textSize="14sp"
        android:textStyle="bold"
        android:lineSpacingExtra="1dp"
        android:textColor="#FFFFFFFF"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="" />

    <TextView
        android:id="@+id/lockMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textSize="13sp"
        android:lineSpacingExtra="2dp"
        android:textColor="#D6FFFFFF"
        android:maxLines="2"
        android:ellipsize="end"
        android:text="" />
</LinearLayout>
